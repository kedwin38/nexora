# NEXORA ISP OS — environment template
# Secrets belong in Railway Variables/Secrets (ADR-008). Never commit real values.

# Core
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Database (PostgreSQL — Railway provides DATABASE_URL for its Postgres service)
DATABASE_URL=postgresql://user:password@localhost:5432/nexora

# Redis (queues/cache — NOT a system of record)
REDIS_URL=redis://localhost:6379

# API service
PORT=5000
HOST=0.0.0.0
SESSION_SECRET=replace-with-32+-char-random-secret
SESSION_TTL_HOURS=24
# mock (local/dev) | mpesa (Daraja)
PAYMENT_PROVIDER=mock
# Mock auto-confirm: DEV ONLY. 0 = disabled (production default — never
# auto-grant service for uncommitted payments). dev:stack sets 3000.
MOCK_PAYMENT_AUTO_CONFIRM_MS=0
# mock (local/dev) | mikrotik (RouterOS API)
ROUTER_ADAPTER=mock
CORS_ORIGIN=*

# Public origin of the API — used to build M-Pesa callback URLs
PUBLIC_BASE_URL=https://your-api-domain
# AES-256-GCM master key (>=32 chars) for tenant-supplied M-Pesa credentials
# at rest (ADR-013). Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=
# Allow public company self-signup (true|false)
ALLOW_TENANT_SIGNUP=true

# Platform owner (cross-tenant governance) — seeded by packages/db/prisma/seed.ts
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
# Default (single-tenant) company super admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# M-Pesa Daraja platform default (sandbox defaults) — per-company config in the
# app overrides this. Not required for API boot.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-api-domain/api/v1/webhooks/mpesa
# paybill | till  (+ MPESA_PARTY_B = till number for Buy Goods)
MPESA_CHANNEL=paybill
MPESA_PARTY_B=

# Router credentials — referenced BY NAME from the Router registry (ADR-008)
ROUTER_OPERATION_TIMEOUT_MS=10000
ROUTER_MAX_ATTEMPTS=5
ROUTER_BACKOFF_BASE_MS=1000
ROUTER_01_PASSWORD=
