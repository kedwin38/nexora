# NEXORA ISP OS — environment template
# Secrets belong in Railway Variables/Secrets (ADR-008). Never commit real values.

# Core
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Database (PostgreSQL — Railway provides DATABASE_URL for its Postgres service)
DATABASE_URL=postgresql://user:password@localhost:5432/nexora

# Redis (queues/cache — NOT a system of record)
REDIS_URL=redis://localhost:6379

# API service
PORT=5000
HOST=0.0.0.0
SESSION_SECRET=replace-with-32+-char-random-secret
MPESA_CALLBACK_URL=https://your-api-domain/api/v1/webhooks/mpesa

# M-Pesa Daraja (sandbox defaults)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Router credentials — referenced BY NAME from the Router registry (ADR-008)
ROUTER_OPERATION_TIMEOUT_MS=10000
ROUTER_MAX_ATTEMPTS=5
ROUTER_BACKOFF_BASE_MS=1000
ROUTER_01_PASSWORD=
