{
  "name": "@nexora/scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs --external:@prisma/client --external:.prisma",
    "start": "node dist/index.cjs"
  },
  "dependencies": {
    "@nexora/config": "*",
    "@nexora/db": "*",
    "@nexora/domain": "*",
    "@nexora/logging": "*"
  }
}
